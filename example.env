# ──────────────────────────────────────────────────────────────────────────────
# FIKA Loan App – Environment Variables Example
# Copy this file to .env and fill in your real values before running the app.
#   cp example.env .env
# ──────────────────────────────────────────────────────────────────────────────

# Flask secret key – generate a strong random value for production:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=myloanapp1234

# ── Database (MySQL / MariaDB) ─────────────────────────────────────────────────
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=1234
DB_NAME=fika_loans

# ── Loan Settings ─────────────────────────────────────────────────────────────
# Monthly flat interest rate (e.g. 0.08 = 8 % per month)
INTEREST_RATE_MONTHLY=0.08

# Maximum loan amount a customer can apply for
MAX_LOAN=5000

# Currency code shown in the UI
CURRENCY=ZMW

# ── Flask Runtime ──────────────────────────────────────────────────────────────
# Set to "production" on a live server; keep "development" for local work
FLASK_ENV=development
FLASK_DEBUG=1